# ===== DeepSeek 对话配置 =====
# 把你在 platform.deepseek.com 申请的 API Key 填到下面等号后面即可。
# 例如：DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# 以下都有默认值，一般无需修改。

# DeepSeek 的 Anthropic 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# 模型：deepseek-v4-pro（推理更强）/ deepseek-v4-flash（更快更省）
DEEPSEEK_MODEL=deepseek-v4-pro

# 单次回复最大输出 token 数
DEEPSEEK_MAX_TOKENS=8192

# ===== 联网搜索配置（SerpAPI）=====
# 在 https://serpapi.com 申请后填到下面等号后面，WebSearch 工具才能联网搜索。
# 代码同时兼容 SERP_API_KEY 和 SERPAPI_KEY 两种命名。
SERP_API_KEY=
